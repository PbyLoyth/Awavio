<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build on Linux/macOS CI too; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Awavio.Windows</RootNamespace>
    <AssemblyName>Awavio</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>..\..\resources\awavio.ico</ApplicationIcon>
    <Product>Awavio</Product>
    <Description>A colorful Windows companion for timed awake sessions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Awavio.Core\Awavio.Core.csproj" />
    <InternalsVisibleTo Include="Awavio.Windows.Smoke" />
    <InternalsVisibleTo Include="Awavio.DesignCapture" />
  </ItemGroup>
</Project>
